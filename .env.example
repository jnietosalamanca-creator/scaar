# ============================================================
# SCAAR — variables de entorno
# Copiar a .env y rellenar antes de levantar docker compose.
# .env NO debe entrar a git.
# ============================================================

# --- Postgres ---
POSTGRES_USER=scaar
POSTGRES_PASSWORD=scaar_dev
POSTGRES_DB=scaar
DATABASE_URL=postgresql+psycopg://scaar:scaar_dev@db:5432/scaar

# --- App ---
APP_ENV=dev
APP_LOG_LEVEL=INFO

# --- JWT ---
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_me_use_long_random_value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_MIN=60

# --- Firma del veredicto del proyectista (HMAC) ---
# Llave separada del JWT por separación de dominios.
# Si rota, las firmas viejas siguen verificables sólo si guardas la versión.
VERDICT_HMAC_SECRET=change_me_use_long_random_value
VERDICT_HMAC_KEY_VERSION=v1

# --- ML ---
ML_ARTIFACTS_DIR=/app/app/ml/artifacts
ML_ACTIVE_MODEL_VERSION=  # se rellena tras primer entrenamiento
